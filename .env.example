# Vercel Cron Secret (used to authorize the automated cron HTTP requests)
# In production on Vercel, this is auto-generated or manually defined
# in Project Settings -> Environment Variables.
CRON_SECRET=your_super_secret_cron_token_here_random_string_32_chars

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Your Telegram User ID or Group/Channel ID (from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id

# Operational Heartbeat Configuration
# When set to "true", sends a Telegram summary even if 0 jobs matched, giving you 100% confirmation
# that all 8 state portals were successfully scanned at 10:00 AM IST.
ALWAYS_SEND_HEARTBEAT=true
